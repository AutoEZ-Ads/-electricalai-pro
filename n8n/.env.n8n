# 🚀 N8N Environment Configuration
# For local development and Render.com deployment

# ================================
# DATABASE CONFIGURATION
# ================================
DB_TYPE=postgresdb
DB_POSTGRESDB_HOST=localhost
DB_POSTGRESDB_PORT=5440
DB_POSTGRESDB_DATABASE=n8n_db
DB_POSTGRESDB_USER=n8n_user
DB_POSTGRESDB_PASSWORD=n8n_secure_password

# ================================
# N8N CORE CONFIGURATION
# ================================
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
NODE_ENV=development
N8N_PATH=/
WEBHOOK_URL=http://localhost:5678/

# ================================
# AUTHENTICATION
# ================================
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=electricalai_admin

# ================================
# EXECUTION SETTINGS
# ================================
EXECUTIONS_PROCESS=main
EXECUTIONS_MODE=regular
EXECUTIONS_DATA_PRUNE=true
EXECUTIONS_DATA_MAX_AGE=336
EXECUTIONS_DATA_SAVE_ON_ERROR=all
EXECUTIONS_DATA_SAVE_ON_SUCCESS=all
EXECUTIONS_DATA_SAVE_ON_PROGRESS=false
EXECUTIONS_DATA_SAVE_MANUAL_EXECUTIONS=true

# ================================
# QUEUE CONFIGURATION (Optional)
# ================================
# EXECUTIONS_MODE=queue
# QUEUE_BULL_REDIS_HOST=localhost
# QUEUE_BULL_REDIS_PORT=6380
# QUEUE_HEALTH_CHECK_ACTIVE=true

# ================================
# ELECTRICALAI PRO INTEGRATION
# ================================
ELECTRICALAI_API_URL=http://localhost:8000
ELECTRICALAI_API_KEY=your_electricalai_api_key
ELECTRICALAI_WEBHOOK_SECRET=your_webhook_secret

# ================================
# EXTERNAL SERVICES
# ================================
# OpenAI Integration
OPENAI_API_KEY=sk-your-openai-api-key

# Claude AI Integration
CLAUDE_API_KEY=your-claude-api-key

# Email Configuration
N8N_EMAIL_MODE=smtp
N8N_SMTP_HOST=smtp.gmail.com
N8N_SMTP_PORT=587
N8N_SMTP_USER=your-email@gmail.com
N8N_SMTP_PASS=your-app-password
N8N_SMTP_SENDER=ElectricalAI Pro <noreply@electricalai.pro>

# ================================
# PERFORMANCE & LOGGING
# ================================
N8N_LOG_LEVEL=info
N8N_LOG_OUTPUT=console
N8N_METRICS=true
N8N_METRICS_PREFIX=n8n_

# ================================
# SECURITY SETTINGS
# ================================
N8N_ENCRYPTION_KEY=your-32-character-encryption-key
N8N_USER_MANAGEMENT_DISABLED=false
N8N_PUBLIC_API_DISABLED=false
N8N_COMMUNITY_NODES_ENABLED=true
N8N_SKIP_WEBHOOK_DEREGISTRATION_SHUTDOWN=false

# ================================
# CUSTOM EXTENSIONS
# ================================
N8N_CUSTOM_EXTENSIONS=/home/node/.n8n/custom
NODES_INCLUDE=["n8n-nodes-base.*","@custom-nodes/electrical.*"]

# ================================
# UI CUSTOMIZATION
# ================================
N8N_EDITOR_BASE_URL=http://localhost:5678/
N8N_VERSION_NOTIFICATIONS_ENABLED=true
N8N_TEMPLATES_ENABLED=true
N8N_ONBOARDING_FLOW_DISABLED=false

# ================================
# DEPLOYMENT SPECIFIC
# ================================
# For Render.com deployment
RENDER_EXTERNAL_URL=https://electricalai-n8n.onrender.com
RENDER_INTERNAL_HOST=0.0.0.0
RENDER_INTERNAL_PORT=5678

# For local Docker development
DOCKER_HOST_IP=host.docker.internal

# ================================
# RATE LIMITING
# ================================
N8N_PAYLOAD_SIZE_MAX=16
N8N_METRICS_INCLUDE_API_ENDPOINTS=true
N8N_METRICS_INCLUDE_API_PATH_LABEL=true
N8N_METRICS_INCLUDE_API_METHOD_LABEL=true
N8N_METRICS_INCLUDE_API_STATUS_CODE_LABEL=true

# ================================
# WORKFLOW SETTINGS
# ================================
N8N_WORKFLOW_TAGS_DISABLED=false
N8N_HIRE_BANNER_DISABLED=true
N8N_PERSONALIZATION_ENABLED=false
N8N_DIAGNOSTICS_ENABLED=false
N8N_WORKFLOW_CALLER_POLICY_DEFAULT_OPTION=workflowsFromSameOwner