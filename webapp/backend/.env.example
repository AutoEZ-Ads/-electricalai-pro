# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/electrical_estimation
REDIS_URL=redis://localhost:6379

# Database Pool Configuration
DB_POOL_MAX=20              # Maximum connections in pool
DB_POOL_MIN=2               # Minimum connections in pool
DB_IDLE_TIMEOUT=30000       # Idle connection timeout (ms)
DB_CONNECTION_TIMEOUT=2000  # Connection attempt timeout (ms)
DB_ACQUIRE_TIMEOUT=5000     # Time to wait for connection from pool (ms)
DB_CREATE_TIMEOUT=5000      # Time to create new connection (ms)
DB_DESTROY_TIMEOUT=5000     # Time to destroy connection (ms)
DB_REAP_INTERVAL=1000       # Check for idle connections interval (ms)
DB_RETRY_INTERVAL=200       # Retry connection creation interval (ms)
DB_MAX_RETRIES=5            # Maximum connection retry attempts
DB_APPLICATION_NAME=electrical-estimation-api

# Database SSL Configuration
DB_SSL_REJECT_UNAUTHORIZED=false  # Set to true in production with proper certs
DB_SSL_CA=                        # Path to CA certificate
DB_SSL_KEY=                       # Path to client key
DB_SSL_CERT=                      # Path to client certificate

# Query Performance Monitoring
SLOW_QUERY_THRESHOLD=1000   # Log queries slower than this (ms)
LOG_ALL_QUERIES=false       # Set to true for debugging

# Server Configuration
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000

# N8N Integration
N8N_WEBHOOK_URL=http://localhost:5678
N8N_API_KEY=your_n8n_api_key

# Monday.com Integration
MONDAY_CLIENT_ID=your_monday_client_id
MONDAY_CLIENT_SECRET=your_monday_client_secret
MONDAY_REDIRECT_URI=https://your-domain.com/auth/callback
MONDAY_WEBHOOK_SECRET=your_webhook_secret
MONDAY_SYSTEM_TOKEN=your_system_access_token

# Monday API Retry Configuration
MONDAY_MAX_RETRIES=3
MONDAY_BASE_DELAY=1000  # milliseconds
MONDAY_MAX_DELAY=30000  # milliseconds
MONDAY_FAILURE_THRESHOLD=5  # circuit breaker threshold
MONDAY_RECOVERY_TIMEOUT=60000  # circuit breaker recovery time

# Error Notification System
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK
ADMIN_EMAIL=admin@yourcompany.com
SMTP_ENABLED=false

# Email Configuration (if SMTP_ENABLED=true)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Monitoring & Logging
LOG_LEVEL=info
ENABLE_REQUEST_LOGGING=true
ERROR_NOTIFICATION_THRESHOLD=5  # Send notifications after 5 errors in 10 minutes

# Security
JWT_SECRET=your-super-secret-jwt-key
ENCRYPTION_KEY=your-32-character-encryption-key

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000  # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100  # requests per window

# Feature Flags
ENABLE_AI_CALCULATIONS=true
ENABLE_FLOOR_PLAN_ANALYSIS=true
ENABLE_REAL_TIME_UPDATES=true

# Backup System Configuration
BACKUP_COMPRESSION=true
BACKUP_ENCRYPTION=false
BACKUP_ENCRYPTION_KEY=your-32-character-encryption-key
MAX_LOCAL_BACKUPS=50
MAX_BACKUP_AGE_DAYS=30
MAX_CONCURRENT_BACKUPS=3

# AWS S3 Backup Configuration
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
AWS_BACKUP_BUCKET=your-backup-bucket

# Google Cloud Storage Backup Configuration
GCS_KEY_FILE=/path/to/service-account-key.json
GCS_PROJECT_ID=your-gcs-project-id
GCS_BACKUP_BUCKET=your-gcs-backup-bucket