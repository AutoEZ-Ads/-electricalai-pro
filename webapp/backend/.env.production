# ElectricalAI Pro Backend Production Environment Configuration

# Server Configuration
NODE_ENV=production
PORT=3001
FRONTEND_URL=https://electricalai-frontend.onrender.com

# Database Configuration (Use Render PostgreSQL URL)
DATABASE_URL=postgresql://electricalai_user:password@host:5432/electricalai_prod

# Redis Configuration (Use Render Redis URL)
REDIS_URL=redis://default:password@redis-host:6379

# N8N Integration (Production URLs)
N8N_WEBHOOK_URL=https://electricalai-n8n.onrender.com
N8N_API_KEY=your_production_n8n_api_key_here

# OpenAI Configuration
OPENAI_API_KEY=your_production_openai_api_key_here

# Monday.com Integration (Production)
MONDAY_CLIENT_ID=your_production_monday_client_id_here
MONDAY_CLIENT_SECRET=your_production_monday_client_secret_here
MONDAY_REDIRECT_URI=https://electricalai-pro.onrender.com/auth/callback
MONDAY_WEBHOOK_SECRET=your_production_monday_webhook_secret_here
MONDAY_API_TOKEN=your_production_monday_api_token_here

# JWT Configuration
JWT_SECRET=your_production_jwt_secret_here
JWT_EXPIRES_IN=24h

# External APIs
COPPER_PRICE_API_KEY=your_production_copper_price_api_key_here
WEATHER_API_KEY=your_production_weather_api_key_here

# File Upload Configuration
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads

# Email Configuration (Production SMTP)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your_sendgrid_api_key_here
FROM_EMAIL=noreply@electricalai.pro

# Logging Configuration
LOG_LEVEL=warn
LOG_FILE=./logs/production.log

# Rate Limiting (Production settings)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=200

# Security Configuration
SECURE_COOKIES=true
TRUST_PROXY=true

# Monitoring
SENTRY_DSN=your_sentry_dsn_here
ENABLE_METRICS=true

# Performance
ENABLE_COMPRESSION=true
CORS_ORIGIN=https://electricalai-frontend.onrender.com