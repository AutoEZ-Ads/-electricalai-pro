# ElectricalAI Pro Monday App Environment Variables

# Monday.com Configuration
REACT_APP_MONDAY_CLIENT_ID=your_monday_client_id_here
REACT_APP_MONDAY_API_TOKEN=your_monday_api_token_here

# N8N Integration (PRODUCTION URLS)
REACT_APP_N8N_WEBHOOK_BASE=https://electricalai-n8n.onrender.com
REACT_APP_N8N_API_KEY=your_n8n_api_key_here

# ElectricalAI Pro API (PRODUCTION URLS)
REACT_APP_ELECTRICALAI_API_KEY=your_electricalai_api_key_here
REACT_APP_ELECTRICALAI_BASE_URL=https://electricalai-pro.onrender.com
REACT_APP_BACKEND_API=https://electricalai-pro.onrender.com

# OpenAI API (for floor plan analysis)
REACT_APP_OPENAI_API_KEY=your_openai_api_key_here

# Environment Configuration
REACT_APP_ENVIRONMENT=production
NODE_ENV=production

# Feature Flags
REACT_APP_ENABLE_DEBUG_LOGGING=true
REACT_APP_ENABLE_ANALYTICS=false
REACT_APP_ENABLE_ERROR_REPORTING=false

# App Configuration
REACT_APP_APP_VERSION=1.0.0
REACT_APP_MAX_FILE_SIZE=52428800
REACT_APP_SUPPORTED_FILE_TYPES=.pdf,.dwg,.png,.jpg,.jpeg
REACT_APP_DEFAULT_TIMEOUT=120000

# Hosting Configuration (for production)
REACT_APP_HOST_URL=https://electricalai-monday-app.onrender.com
REACT_APP_WEBHOOK_URL=https://electricalai-monday-app.onrender.com/webhook

# Security Configuration
REACT_APP_ENABLE_CSRF_PROTECTION=true
REACT_APP_SESSION_TIMEOUT=3600000

# Performance Monitoring
REACT_APP_ENABLE_PERFORMANCE_MONITORING=false
REACT_APP_SENTRY_DSN=your_sentry_dsn_here

# Third-party Integrations
REACT_APP_GOOGLE_ANALYTICS_ID=your_ga_id_here
REACT_APP_INTERCOM_APP_ID=your_intercom_app_id_here

# Database Configuration (if using separate backend)
REACT_APP_DATABASE_URL=postgresql://user:password@localhost:5432/electricalai_pro

# Redis Configuration (for caching)
REACT_APP_REDIS_URL=redis://localhost:6379

# Email Configuration
REACT_APP_SENDGRID_API_KEY=your_sendgrid_api_key_here
REACT_APP_SUPPORT_EMAIL=support@electricalai.pro

# Compliance and Security
REACT_APP_ENABLE_GDPR_MODE=true
REACT_APP_ENABLE_AUDIT_LOGGING=true
REACT_APP_DATA_RETENTION_DAYS=730

# Subscription and Billing
REACT_APP_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key_here
REACT_APP_ENABLE_SUBSCRIPTION_MANAGEMENT=true

# Material Cost APIs
REACT_APP_COPPER_PRICE_API_KEY=your_copper_price_api_key_here
REACT_APP_MATERIAL_COST_UPDATE_INTERVAL=3600000

# NEC Compliance Database
REACT_APP_NEC_DATABASE_URL=https://api.necdb.electricalai.pro
REACT_APP_NEC_DATABASE_API_KEY=your_nec_database_api_key_here

# Workflow Configuration
REACT_APP_DEFAULT_WORKFLOW_TIMEOUT=300000
REACT_APP_MAX_CONCURRENT_WORKFLOWS=5
REACT_APP_WORKFLOW_RETRY_ATTEMPTS=3

# File Storage
REACT_APP_AWS_S3_BUCKET=electricalai-files
REACT_APP_AWS_REGION=us-east-1
REACT_APP_AWS_ACCESS_KEY_ID=your_aws_access_key_here
REACT_APP_AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here

# CDN Configuration
REACT_APP_CDN_BASE_URL=https://cdn.electricalai.pro
REACT_APP_STATIC_ASSETS_URL=https://assets.electricalai.pro

# Development Tools
REACT_APP_ENABLE_REACT_DEVTOOLS=true
REACT_APP_ENABLE_REDUX_DEVTOOLS=true
REACT_APP_HOT_RELOAD=true

# Testing Configuration
REACT_APP_TEST_MODE=false
REACT_APP_MOCK_API_RESPONSES=false
REACT_APP_TEST_USER_ID=test_user_123

# Localization
REACT_APP_DEFAULT_LOCALE=en-US
REACT_APP_SUPPORTED_LOCALES=en-US,es-ES,fr-FR

# Rate Limiting
REACT_APP_API_RATE_LIMIT=1000
REACT_APP_RATE_LIMIT_WINDOW=3600000

# Backup and Recovery
REACT_APP_BACKUP_ENABLED=true
REACT_APP_BACKUP_INTERVAL=86400000
REACT_APP_BACKUP_RETENTION_DAYS=30