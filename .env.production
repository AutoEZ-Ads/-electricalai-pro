# 🚀 ElectricalAI Pro - Production Environment Configuration
# Secure configuration for production deployment

# ================================
# APPLICATION SETTINGS
# ================================
NODE_ENV=production
VERSION=1.0.0
LOG_LEVEL=info
DEBUG=false

# ================================
# DATABASE CONFIGURATION
# ================================
DATABASE_URL=postgresql://n8n_user:GENERATED_PASSWORD@postgres:5432/electrical_estimation
DATABASE_PASSWORD=GENERATED_SECURE_PASSWORD
DB_MAX_CONNECTIONS=100
DB_CONNECTION_TIMEOUT=30000

# ================================
# REDIS CONFIGURATION
# ================================
REDIS_URL=redis://redis:6379
REDIS_PASSWORD=GENERATED_REDIS_PASSWORD
REDIS_MAX_CONNECTIONS=50

# ================================
# SECURITY SETTINGS
# ================================
JWT_SECRET=GENERATED_JWT_SECRET_64_CHARS
API_KEY=GENERATED_API_KEY_32_CHARS
ENCRYPTION_KEY=GENERATED_ENCRYPTION_KEY
SESSION_SECRET=GENERATED_SESSION_SECRET

# ================================
# SERVICE URLS
# ================================
FRONTEND_URL=https://electricalai.pro
BACKEND_URL=https://api.electricalai.pro
N8N_URL=https://n8n.electricalai.pro
MONITORING_URL=https://monitoring.electricalai.pro

# ================================
# DOMAIN CONFIGURATION
# ================================
DOMAIN=electricalai.pro
API_DOMAIN=api.electricalai.pro
N8N_DOMAIN=n8n.electricalai.pro
MONITORING_DOMAIN=monitoring.electricalai.pro

# ================================
# N8N CONFIGURATION
# ================================
N8N_HOST=n8n.electricalai.pro
N8N_PORT=5678
N8N_PROTOCOL=https
N8N_USER=admin
N8N_PASSWORD=GENERATED_N8N_PASSWORD
N8N_BASIC_AUTH_ACTIVE=true

# ================================
# AI SERVICE KEYS
# ================================
OPENAI_API_KEY=sk-your-openai-key-here
CLAUDE_API_KEY=your-claude-key-here
GOOGLE_AI_KEY=your-google-ai-key-here

# ================================
# EXTERNAL API KEYS
# ================================
RS_MEANS_API_KEY=your-rs-means-key-here
NECA_API_KEY=your-neca-key-here
WEATHER_API_KEY=your-weather-key-here
MAPS_API_KEY=your-maps-key-here

# ================================
# EMAIL CONFIGURATION
# ================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@electricalai.pro
SMTP_PASSWORD=GENERATED_SMTP_PASSWORD
FROM_EMAIL=ElectricalAI Pro <noreply@electricalai.pro>

# ================================
# STORAGE CONFIGURATION
# ================================
STORAGE_TYPE=gcs
GCS_BUCKET=electricalai-pro-storage
GCS_PROJECT_ID=electricalai-prod
UPLOAD_MAX_SIZE=50MB
ALLOWED_FILE_TYPES=pdf,dwg,dxf,jpg,png

# ================================
# MONITORING & ANALYTICS
# ================================
GRAFANA_USER=admin
GRAFANA_PASSWORD=GENERATED_GRAFANA_PASSWORD
PROMETHEUS_URL=http://prometheus:9090
SENTRY_DSN=your-sentry-dsn-here
GOOGLE_ANALYTICS_ID=GA-XXXXXXXXX

# ================================
# RATE LIMITING
# ================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_SKIP_SUCCESSFUL_REQUESTS=true

# ================================
# PAYMENT PROCESSING
# ================================
STRIPE_PUBLISHABLE_KEY=pk_live_your_stripe_key
STRIPE_SECRET_KEY=sk_live_your_stripe_secret
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# ================================
# BACKUP CONFIGURATION
# ================================
BACKUP_RETENTION_DAYS=30
BACKUP_SCHEDULE=0 3 * * *
BACKUP_BUCKET=electricalai-pro-backups
BACKUP_ENCRYPTION_KEY=GENERATED_BACKUP_KEY

# ================================
# SSL/TLS CONFIGURATION
# ================================
SSL_CERT_PATH=/etc/nginx/ssl/live/electricalai.pro/fullchain.pem
SSL_KEY_PATH=/etc/nginx/ssl/live/electricalai.pro/privkey.pem
SSL_DHPARAM_PATH=/etc/nginx/ssl/dhparam.pem

# ================================
# GOOGLE CLOUD CONFIGURATION
# ================================
GOOGLE_CLOUD_PROJECT=electricalai-prod
GOOGLE_APPLICATION_CREDENTIALS=/app/service-account.json
GCP_REGION=us-central1
GCP_ZONE=us-central1-a

# ================================
# KUBERNETES CONFIGURATION
# ================================
KUBERNETES_NAMESPACE=electricalai-prod
KUBERNETES_SERVICE_ACCOUNT=electricalai-service-account
KUBERNETES_CLUSTER_NAME=electricalai-cluster

# ================================
# FEATURE FLAGS
# ================================
ENABLE_REGISTRATION=true
ENABLE_PAYMENTS=true
ENABLE_ANALYTICS=true
ENABLE_CHAT_SUPPORT=true
ENABLE_MOBILE_APP=true
ENABLE_API_DOCS=true

# ================================
# PERFORMANCE SETTINGS
# ================================
MAX_WORKERS=4
WORKER_TIMEOUT=300
KEEPALIVE_TIMEOUT=65
MAX_REQUESTS_PER_WORKER=1000
PRELOAD_APP=true

# ================================
# COMPLIANCE & LEGAL
# ================================
PRIVACY_POLICY_URL=https://electricalai.pro/privacy
TERMS_OF_SERVICE_URL=https://electricalai.pro/terms
GDPR_COMPLIANCE=true
CCPA_COMPLIANCE=true

# ================================
# DEVELOPMENT/STAGING OVERRIDES
# ================================
# Uncomment for staging environment
# NODE_ENV=staging
# FRONTEND_URL=https://staging.electricalai.pro
# BACKEND_URL=https://api-staging.electricalai.pro

# ================================
# DEPLOYMENT METADATA
# ================================
DEPLOY_DATE=2025-01-31
DEPLOY_VERSION=v1.0.0
DEPLOY_COMMIT=main
DEPLOY_ENVIRONMENT=production

# ================================
# HEALTH CHECK CONFIGURATION
# ================================
HEALTH_CHECK_TIMEOUT=30
HEALTH_CHECK_INTERVAL=60
HEALTH_CHECK_RETRIES=3
HEALTH_CHECK_START_PERIOD=40

# ================================
# LOGGING CONFIGURATION
# ================================
LOG_FORMAT=json
LOG_ROTATION=daily
LOG_MAX_FILES=30
LOG_MAX_SIZE=100MB
LOG_COMPRESS=true

# ================================
# SECURITY HEADERS
# ================================
SECURITY_HSTS_MAX_AGE=31536000
SECURITY_CONTENT_TYPE_NOSNIFF=true
SECURITY_FRAME_OPTIONS=DENY
SECURITY_XSS_PROTECTION=1; mode=block

# ================================
# CORS CONFIGURATION
# ================================
CORS_ORIGIN=https://electricalai.pro,https://app.electricalai.pro
CORS_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization,X-Requested-With
CORS_CREDENTIALS=true

# ================================
# WEBHOOKS & INTEGRATIONS
# ================================
SLACK_WEBHOOK_URL=your-slack-webhook-url
DISCORD_WEBHOOK_URL=your-discord-webhook-url
TEAMS_WEBHOOK_URL=your-teams-webhook-url
ZAPIER_WEBHOOK_URL=your-zapier-webhook-url